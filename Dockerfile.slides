FROM python:3.12-slim-bookworm

ARG PYMUPDF_VERSION
ARG PILLOW_VERSION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-est \
        libreoffice-impress-nogui \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN test -n "$PYMUPDF_VERSION" \
    && test -n "$PILLOW_VERSION" \
    && pip install --no-cache-dir "PyMuPDF==${PYMUPDF_VERSION}" \
    && pip install --no-cache-dir "Pillow==${PILLOW_VERSION}" \
    && pip install --no-cache-dir --no-deps .

ENTRYPOINT ["lecture-slides"]
CMD ["--help"]
